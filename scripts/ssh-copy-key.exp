#!/usr/bin/expect -f
set host [lindex $argv 0]
set user [lindex $argv 1]
set pass [lindex $argv 2]

spawn ssh-copy-id -o StrictHostKeyChecking=no $user@$host
expect {
    "*assword*" {
        send "$pass\r"
        exp_continue
    }
    "already exist" {
        exit 0
    }
    eof {
        exit 0
    }
}
